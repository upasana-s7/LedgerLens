# ---------------------------------------------------------------------------
# LedgerLens backend - example environment file
#
# Copy this file to `.env` and fill in your own values:
#     Windows :  copy .env.example .env
#     Mac/Linux: cp .env.example .env
#
# NOTE: `.env` is git-ignored. NEVER commit real API keys or passwords.
# ---------------------------------------------------------------------------

# App metadata (shown in /docs and /api/health)
APP_NAME=LedgerLens API
VERSION=0.1.0

# SQLite database file (created inside backend/ from Stage 2 onwards)
DATABASE_URL=sqlite:///./ledgerlens.db

# Google Gemini (Stage 8). Leave empty to use the rule-based fallback text.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Fixed "today" for the demo so numbers are reproducible (YYYY-MM-DD)
AS_OF_DATE=2026-11-19

# Fill an empty database with the fictional "Bloom & Bean" sample data on
# startup. Existing data is never overwritten.
AUTO_SEED=true

# Allowed frontend origins (JSON list, because it is a list of strings).
# Vite dev server = 5173, `vite preview` = 4173.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
